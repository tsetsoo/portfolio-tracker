DATABASE_PATH=./data/portfolio.db
# optional
FINNHUB_API_KEY=

# Telegram price alerts (both required to send)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional — evaluation interval, default 600000 (10 min); a value below
# 60000, or non-numeric, falls back to the 600000 default rather than being
# clamped up to it. The pass fetches quotes from price_cache without
# `force`, and that cache's TTL is 10 minutes, so going below it just
# re-evaluates the same cached price more often — effective freshness stays
# at 10 minutes no matter how low this is set
ALERTS_INTERVAL_MS=
# optional — 1 forces the scheduler on in dev, 0 forces it off in production
ALERTS_ENABLED=
