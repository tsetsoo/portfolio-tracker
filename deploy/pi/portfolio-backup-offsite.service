[Unit]
Description=Encrypt the newest portfolio backup and push it off the device
After=network-online.target portfolio-backup.service
Wants=network-online.target

[Service]
Type=oneshot
User=pi
Group=pi
ExecStart=/opt/portfolio/portfolio-backup-offsite.sh
# Deliberately a separate unit from portfolio-backup.service rather than a
# second ExecStart: a provider outage should read as "the offsite copy did not
# go" and not as "the backup failed", because the local copy did succeed and
# the two need fixing in different places.
#
# Non-zero exits stand, so failures surface in `journalctl -u
# portfolio-backup-offsite`.
#
# Bounded for the same reason as portfolio-backup.service: Type=oneshot would
# otherwise default to infinity and a hung network or docker call would leave
# the unit activating forever rather than failing. This has to exceed
# BACKUP_WAIT (900s, the time it will wait for a running local backup) plus the
# encrypt, upload and read-back.
TimeoutStartSec=1800
