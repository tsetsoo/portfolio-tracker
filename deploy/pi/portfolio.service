[Unit]
Description=Portfolio tracker (Next.js + SQLite, containerised)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/portfolio
Environment=PORT=8081
# run-container.sh picks the runtime image from the release's NODE_IMAGE file,
# falling back to the host's Node 18 for pre-container releases.
ExecStart=/opt/portfolio/run-container.sh
ExecStopPost=-/usr/bin/docker rm -f portfolio-app
Restart=on-failure
RestartSec=3
# Pulling the runtime image on a cold start can take a while on a Pi 3.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
