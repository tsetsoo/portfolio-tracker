[Unit]
Description=Portfolio tracker (Next.js + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/portfolio/current
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=8081
Environment=DATABASE_PATH=/opt/portfolio/data/portfolio.db
ExecStart=/opt/portfolio/node/bin/node /opt/portfolio/current/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
