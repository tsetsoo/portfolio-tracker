[Unit]
Description=Back up the portfolio database (consistent copy, verified, rotated)
After=portfolio.service docker.service
Wants=portfolio.service

[Service]
Type=oneshot
# pi owns /opt/portfolio/data and is in the docker group, which is all this
# needs — the copy is made by the app container, not by root.
User=pi
Group=pi
ExecStart=/opt/portfolio/portfolio-backup.sh
# A silent backup failure is worse than no backup, so let a non-zero exit stand
# and surface in `journalctl -u portfolio-backup`. Same precedent as
# portfolio-snapshot.service.
#
# Type=oneshot defaults TimeoutStartSec to infinity, which would let a wedged
# docker daemon park this unit in "activating" forever: never logged as failed,
# and the next night's timer elapse merged into the stuck job, so backups would
# stop silently. That is the failure this unit exists to make loud.
#
# This has to exceed the script's real worst case, or systemd SIGTERMs it
# mid-retry, COPY_ATTEMPTS is never honoured, and the script's own explanatory
# failure never reaches the journal. That worst case is
# COPY_ATTEMPTS(3) x (CONTAINER_WAIT(120) + COPY_TIMEOUT(120)) plus two
# RETRY_DELAY(30) gaps = 780s. Keep this above that if those knobs change.
TimeoutStartSec=1200
